{
  "name": "top-draw",
  "version": "1.6.3-beta",
  "description": "A multiplayer drawing application with WebSocket support",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --open /go/\"",
    "build": "vite build",
    "build:itch": "vite build && node scripts/itch-patch.js",
    "build:preview": "npm run build && npm run preview",
    "vite": "vite",
    "preview": "vite preview",
    "server": "cross-env HOST=127.0.0.1 PORT=8030 node server/index.js",
    "test:sync": "node testing/tool_sync_suite.js",
    "server:stress": "cross-env HOST=127.0.0.1 PORT=8030 DISABLE_RATE_LIMITS=true node server/index.js",
    "snapshots:cleanup-legacy": "node server/scripts/delete-legacy-snapshots.js",
    "dev:stress": "concurrently \"npm run server:stress\" \"vite --open /go/\"",
    "messenger": "node server/messenger.js",
    "start": "node server/index.js",
    "docs": "jsdoc -r src server shared -d docs/jsdocs",
    "wasm": "wasm-pack build wasm_src --target web --out-dir ../src/wasm/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:update": "node scripts/release/tauri-update.mjs",
    "tauri:update:publish": "node scripts/release/tauri-update.mjs --publish-only",
    "tauri:update:stage": "node scripts/release/tauri-update.mjs --stage-only",
    "release:set": "node scripts/release/versioning.mjs set",
    "release:patch": "node scripts/release/versioning.mjs patch",
    "release:minor": "node scripts/release/versioning.mjs minor",
    "release:major": "node scripts/release/versioning.mjs major",
    "release:prepatch": "node scripts/release/versioning.mjs prepatch",
    "release:preminor": "node scripts/release/versioning.mjs preminor",
    "release:premajor": "node scripts/release/versioning.mjs premajor",
    "release:beta": "node scripts/release/versioning.mjs beta",
    "release:promote": "node scripts/release/versioning.mjs promote"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.5",
    "mitata": "^1.0.34",
    "puppeteer": "^22.15.0",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "svelte": "^5.55.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "bcrypt": "^6.0.0",
    "delaunator": "^5.0.1",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.6",
    "mongodb": "^7.1.0",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.0.0",
    "reinvented-color-wheel": "^0.4.0",
    "sharp": "^0.34.5",
    "stackblur": "^1.0.0",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
