{
  "name": "top-draw",
  "version": "1.0.0",
  "description": "A multiplayer drawing application with WebSocket support",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "build": "npm run brushes && vite build",
    "build:preview": "npm run build && npm run preview",
    "vite": "vite",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "brushes": "node scripts/generate-brush-manifest.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "mitata": "^1.0.34",
    "sass": "^1.97.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "delaunator": "^5.0.1",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.0.0",
    "stackblur": "^1.0.0",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
