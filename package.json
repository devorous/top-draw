{
  "name": "top-draw",
  "version": "1.0.0",
  "description": "A multiplayer drawing application with WebSocket support",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --open /go/\"",
    "build": "vite build",
    "build:preview": "npm run build && npm run preview",
    "vite": "vite",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:stress": "cross-env DISABLE_RATE_LIMITS=true node server/index.js",
    "snapshots:cleanup-legacy": "node server/scripts/delete-legacy-snapshots.js",
    "dev:stress": "concurrently \"npm run server:stress\" \"vite --open /go/\"",
    "messenger": "node server/messenger.js",
    "start": "node server/index.js",
    "docs": "jsdoc -r src server shared -d docs/jsdocs",
    "wasm": "wasm-pack build wasm_src --target web --out-dir ../src/wasm/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0-rc.6",
    "@tauri-apps/cli": "^2.0.0-rc.18",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.5",
    "mitata": "^1.0.34",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "svelte": "^5.55.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "bcrypt": "^6.0.0",
    "delaunator": "^5.0.1",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.6",
    "mongodb": "^7.1.0",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.0.0",
    "sharp": "^0.34.5",
    "stackblur": "^1.0.0",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
