{
  "name": "top-draw",
  "version": "1.0.0",
  "description": "A multiplayer drawing application with WebSocket support",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --open /go/\"",
    "build": "npm run brushes && vite build",
    "build:preview": "npm run build && npm run preview",
    "vite": "vite",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "brushes": "node scripts/generate-brush-manifest.js",
    "docs": "jsdoc -r src server shared -d docs/jsdocs",
    "wasm": "wasm-pack build wasm_src --target web --out-dir ../src/wasm/"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jsdoc": "^4.0.5",
    "mitata": "^1.0.34",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "bcrypt": "^6.0.0",
    "delaunator": "^5.0.1",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.0.0",
    "stackblur": "^1.0.0",
    "svelte": "^4.2.20",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
