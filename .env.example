# WebSocket server URL (optional - defaults to same host as frontend)
# VITE_WS_SERVER_URL=ws://localhost:8000

# WebSocket server port (used by server/index.js)
PORT=8000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/topdraw

# JWT secret for auth tokens (use a long random string)
JWT_SECRET=change-me-to-a-random-secret
