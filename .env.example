# Local app server
HOST=127.0.0.1
PORT=8030
PUBLIC_APP_URL=http://localhost:5173
VITE_WS_SERVER_URL=ws://localhost:8030
VITE_API_BASE_URL=http://localhost:8030
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=Draw
JWT_SECRET=
IP_SALT=
TRUST_PROXY=false
MAX_WS_BUFFERED_BYTES=16777216
MAX_OUTBOX_BYTES=4194304
MAX_OUTBOX_MESSAGES=512

# Production storage. Set REQUIRE_*_R2=false only for a deployment that
# intentionally disables the corresponding feature.
REQUIRE_GALLERY_R2=true
REQUIRE_SNAPSHOT_R2=true
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_SNAPSHOTS_BUCKET=
R2_SNAPSHOTS_ACCESS_KEY_ID=
R2_SNAPSHOTS_SECRET_KEY=
R2_TIMELAPSE_BUCKET=
R2_TIMELAPSE_PUBLIC_URL=
R2_TIMELAPSE_ACCESS_KEY_ID=
R2_TIMELAPSE_SECRET_KEY=
SNAPSHOT_MAX_PER_ROOM=100
ALLOW_DEV_SNAPSHOTS=false
ENABLE_SERVER_REPLAY_DB=false

# Discord bot and OAuth
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8030/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_GALLERY_CHANNEL_ID=
DISCORD_UPDATES_CHANNEL_ID=
DISCORD_READY_TIMEOUT_MS=30000
DISCORD_AUTO_POST_UPDATES=false
DISCORD_UPDATE_SECRET=
DISCORD_INVITE_URL=

# Tiled canvas backing store (server/tiledCanvasConfig.js).
# ON by default in code — no variable needs to be set. These exist only to turn
# it OFF, and are read as opt-out (`!== 'false'`), because the deployed image
# gets no .env at all (.dockerignore excludes it), so anything gated behind an
# unset `=== 'true'` check is silently off in production.
#   ENABLE_TILED_CANVAS_BACKING_STORE=false   kill the feature everywhere
#   TILED_CANVAS_FORCE_ALL=false              back to per-room opt-in
#   TILED_CANVAS_DEFAULT=false                new rooms start untiled
