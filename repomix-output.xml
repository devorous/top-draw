.saveUploadGroup {
  display: flex;
  gap: var(--space-2);
  flex-shrink: 0;
}

#rotationResetBtn {
  font-size: 14px;
}

.mirrorOption,
.devOption,
.zoomPercent {
  padding: 0 2px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  white-space: nowrap;
}

.devOption {
  color: var(--text-muted);
}

.devOption.active {
  color: var(--accent-primary);
}

.right {
  margin-left: auto;
  display: flex;
  gap: var(--space-2);
  align-items: center;
  flex-shrink: 0;
  min-width: 0;
}

#chatBtn,
#inboxBtn {
  position: relative;
}

#chatBtn .chatBadge,
#inboxBtn .chatBadge {
  position: absolute;
  top: -6px;
  right: -6px;
  display: none;
  min-width: 18px;
  height: 18px;
  align-items: center;
  justify-content: center;
  padding: 0 5px;
  border-radius: 999px;
  background: var(--accent-primary);
  color: var(--bg-primary);
  font-size: 0.68rem;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--bg-elevated) 92%, black);
  pointer-events: none;
  z-index: 1;
}

@mixin toolbar-icon-collapse($button-selector) {
  #{$button-selector} {
    .btnText {
      display: none;
    }

    .btnIcon {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      margin-right: 0;

      img {
        width: 18px;
        height: 18px;
        object-fit: contain;
        filter: brightness(0) invert(0.7);
        transition: filter var(--transition-fast);
      }
    }

    width: 28px;
    min-width: 28px;
    padding: 0;

    &:hover .btnIcon img {
      filter: brightness(0) invert(1);
    }
  }
}

.boardBtns.force-right-icon-collapse {
  @include toolbar-icon-collapse('.saveUploadGroup .btn, #inboxBtn, #disconnectBtn, #roomSettingsBtn');

  #chatBtn .btnIcon img,
  #inboxBtn .btnIcon img {
    width: 24px;
    height: 24px;
  }
}

.boardBtns.force-left-icon-collapse {
  @include toolbar-icon-collapse('#mirrorBtn, #appSettingsBtn');
}

.boardBtns.force-menu-collapse {
  .btn.menuBtn {
    display: inline-flex;
  }

  .collapsibleBtns {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-lg);
    z-index: 105;
    align-items: stretch;
    min-width: 180px;
    gap: var(--space-3);

    &.show {
      display: flex !important;
      animation: menuFadeIn 0.2s ease;
    }

    .btn {
      justify-content: flex-start;
      width: 100%;
      min-width: 0;
      height: 36px;
      padding: 8px;
    }

    .btnText {
      display: inline;
    }

    .btnIcon {
      display: none !important;
      margin-right: 8px;
    }

    .mirrorContainer, .devContainer {
      justify-content: space-between;
      padding: 0 var(--space-1);
    }
  }
}

/* ========================================
   Responsive Toolbar
   ======================================== */

// Breakpoint for collapsing secondary actions into menu
@include respond-below(xl) {
  .btn.menuBtn {
    display: inline-flex; // Show hamburger
  }

  .collapsibleBtns {
    display: none; // Hide from main bar
    flex-direction: column;
    position: absolute;
    top: 100%; 
    left: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-lg);
    z-index: 105;
    align-items: stretch;
    min-width: 180px;
    gap: var(--space-3);

    &.show {
      display: flex !important;
      animation: menuFadeIn 0.2s ease;
    }

    .btn {
      justify-content: flex-start;
      width: 100%;
      height: 36px; // Slightly taller buttons in the dropdown for touch
    }

    .mirrorContainer, .devContainer {
      justify-content: space-between;
      padding: 0 var(--space-1);
    }
  }

  .zoomPercent {
    padding: 0 2px;
  }
}

// Breakpoint for condensing text to icons (e.g., Save/Upload/Chat/Exit)
@include respond-below(lg) {
  @include toolbar-icon-collapse('.saveUploadGroup .btn, #inboxBtn, #disconnectBtn, #roomSettingsBtn');

  #chatBtn .btnIcon img, #inboxBtn .btnIcon img {
    width: 24px;
    height: 24px;
  }
}

// Further adjustments for smaller screens
@include respond-below(md) {
  .boardBtns {
    padding: 6px 10px;
  }
}

@include respond-below(sm) {
  .boardBtns {
    padding: 6px 8px;
    gap: var(--space-1);
  }
  
  .zoomGroup {
    gap: var(--space-1);
  }
  
  .right {
    gap: var(--space-1);
  }
  
  .saveUploadGroup {
    gap: var(--space-1);
  }
}

@keyframes menuFadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
