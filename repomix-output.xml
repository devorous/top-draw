    if (!window.history.state?._topDrawSentinel) {
      window.history.pushState({ _topDrawSentinel: true }, '');
    }
    window.addEventListener('popstate', (e) => {
      if (!e.state?._topDrawSentinel) {
        // Re-push sentinel so back button is re-armed
        window.history.pushState({ _topDrawSentinel: true }, '');
