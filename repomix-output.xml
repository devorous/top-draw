  >
    <div class="admin-dialog">
      <div class="admin-header">
        <div>
          <h3>Admin Panel</h3>
          <p>Deity-only server overview and database browser.</p>
        </div>
        <button class="admin-close" onclick={hide} title="Close">&times;</button>
      </div>

      {#if error}
        <div class="admin-error">{error}</div>
