<file path="src/css/features/_performance-settings.scss">
// ========================================
// Performance Settings Dialog
// ========================================

@use '../abstracts' as *;

.perfSettingsOverlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 300;

  &.visible {
    display: flex;
  }
}

.perfSettingsDialog {
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
