    order: -1; // Put handle on the other side of toolOptions
  }
  .tools-resizer {
    right: auto;
    left: -2px;
  }
}

html[data-sidebar-side='left'] #toolOptions {
  border-left: 0;
  border-right: 1px solid var(--border-subtle);
}

html[data-sidebar-side='left'] #toolOptions.collapsed {
  border-right-width: 0;
  transform: translateX(-20px);
