      const next = channelMessages[index + 1];
      const groupedWithPrevious = Boolean(
        previous &&
        isChatMessage(previous) &&
        isChatMessage(msg) &&
        Number(previous.userId) === Number(msg.userId) &&
        msg.timestamp - previous.timestamp < 60_000
      );
      const groupedWithNext = Boolean(
