    <!-- Initial Loading Styles -->
    <style id="initial-loading-style">
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      #main {
        opacity: 0;
      }
      #app-loading-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #121212;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 999999;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        transition: opacity 0.4s ease-out;
      }
      html[data-desktop-app='true'] #app-loading-screen {
        top: var(--desktop-titlebar-height);
        height: calc(100% - var(--desktop-titlebar-height));
      }
      #app-loading-screen .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        border-top-color: #00d4aa;
        animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        margin-bottom: 24px;
        box-sizing: content-box;
      }
      #app-loading-screen .loading-text {
        color: #ffffff;
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.6;
      }
      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
    </style>

    <style id="rank-styles">
      /* User Rank Styling */
      .rank-guest {
        color: var(--role-guest);
      }

      .rank-user {
        color: var(--role-user);
      }

      .rank-helper {
        color: var(--role-helper);
        font-weight: 500;
      }

      .rank-mod {
        color: var(--role-mod);
        font-weight: 600;
      }

      .rank-admin {
        color: var(--role-admin);
        font-weight: 600;
        text-shadow: 0 0 4px color-mix(in srgb, var(--role-admin), transparent 70%);
      }

      .rank-noble {
        color: var(--role-noble);
        font-weight: 700;
        text-shadow: 0 0 8px color-mix(in srgb, var(--role-noble), transparent 40%);
      }

      .rank-holy {
        color: var(--role-holy);
        font-weight: 700;
        text-shadow: 0 0 10px color-mix(in srgb, var(--role-holy), transparent 30%);
      }

      .rank-deity {
        color: var(--role-deity);
        font-weight: 700;
        text-shadow: 0 0 12px color-mix(in srgb, var(--role-deity), transparent 50%);
      }

      /* Row glow effects for Noble/Holy/Deity entries */
      .listEntry.rank-noble {
        background: color-mix(in srgb, var(--role-noble), transparent 92%);
        border-left: 2px solid color-mix(in srgb, var(--role-noble), transparent 60%);
      }

      .listEntry.rank-holy {
        background: color-mix(in srgb, var(--role-holy), transparent 90%);
        border-left: 2px solid color-mix(in srgb, var(--role-holy), transparent 50%);
      }

      .listEntry.rank-deity {
        background: color-mix(in srgb, var(--role-deity), transparent 88%);
        border-left: 3px solid color-mix(in srgb, var(--role-deity), transparent 40%);
        box-shadow: inset 0 0 12px color-mix(in srgb, var(--role-deity), transparent 90%);
      }

    </style>

    <style>
      .cursor.self.zoom-hide-name .name { display: none !important; }
    </style>

    <!-- Styles -->
