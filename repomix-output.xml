@use '../abstracts' as *;

/* ========================================
   Top Toolbar
   ======================================== */

.boardBtns {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 5px 6px;
  background: var(--surface-glass);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-subtle);
  z-index: 100;
  position: relative;
  flex-wrap: nowrap;
  
  // Standardize button height across the entire toolbar
  .btn {
    height: 28px;
    width: fit-content;
    padding-top: 0;
    padding-bottom: 0;
    padding: 8px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center; // Ensure content is centered
  }
}

// Accent button style (e.g., Register Room)
.btn.accent {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  border: 1px solid #7c3aed;
  color: #fff;

  &:hover {
    background: linear-gradient(135deg, #6d28d9, #9333ea);
    border-color: #6d28d9;
  }
}

.btn.menuBtn {
  display: none; // Hidden by default on desktop
  font-size: 18px;
  width: 34px; // Slightly wider for the hamburger
  padding-left: 0;
  padding-right: 0;
  z-index: 110;
  justify-content: center;
  
  .menuIcon {
    line-height: 1;
    display: flex; // Changed to flex for centering
    align-items: center;
    justify-content: center;
    margin-top: -2px; // Optical adjustment for the hamburger character
  }
}

.collapsibleBtns {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.mirrorContainer, .devContainer {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.zoomGroup {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.zoomBtns {
  display: flex;
  gap: 4px;

  .btn img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    filter: brightness(0) invert(0.7);
    transition: filter var(--transition-fast);
  }

  .btn:hover img {
    filter: brightness(0) invert(1);
  }

  .btn.selected img {
    filter: brightness(0) invert(0.1);
  }
}

#recordBtn {
