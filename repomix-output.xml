  flex-direction: row;
  height: 100%;
  z-index: 110;
  user-select: none;
  flex-shrink: 0;
  border-left: 1px solid var(--border-subtle);
  background: var(--bg-secondary);
}

html[data-sidebar-side='left'] #sideMenu {
  flex-direction: row-reverse;
  border-left: 0;
  border-right: 1px solid var(--border-subtle);
}

// Sidebar should ONLY collapse the options panel, keeping the tools bar visible
#toolOptions {
  display: flex;
  flex-direction: column;
  width: var(--sidebar-width);
  background: var(--bg-tertiary);
  border-left: 1px solid var(--border-subtle);
  transition: width var(--transition-normal), opacity var(--transition-normal), transform var(--transition-normal);
  overflow: hidden;
  
  &.collapsed {
    width: 0;
    opacity: 0;
    border-left-width: 0;
    pointer-events: none;
    transform: translateX(20px);
  }
}

#sidebarTop {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

#sidebarBottom {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
