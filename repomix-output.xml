// ========================================
// Tool Sidebar
// ========================================

@use '../abstracts' as *;

/* ========================================
   Side Menu
   ======================================== */

:root {
  // Default width variables (overridden by JS)
  --sidebar-width: 200px;
  --tools-width: 48px;
}

#sideMenu {
