<file path="src/css/layout/_panels.scss">
// ========================================
// Side Menu & Panels
// ========================================

@use '../abstracts' as *;

/* ========================================
   User List
   ======================================== */

#userList {
  display: flex;
  flex-direction: column;
  gap: 0px;
  padding: 2.5px;
  padding-top: 1px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
  overflow-y: auto;
  /* Height is dynamically managed by ResizableSections */
}

.userListControls {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}

.userListSortLabel {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.userListSort {
  min-width: 102px;
  height: 24px;
  padding: 0 22px 0 8px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background: var(--bg-tertiary);
  color: var(--text-primary);
  font-size: 11px;
  line-height: 1;
  cursor: pointer;
}

.userListSort:hover {
  background: var(--bg-elevated);
}

.userEntry {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 1px 5px;
  background: var(--bg-tertiary);
  border-radius: var(--radius-sm);
  font-size: 13px;

  &.muted {
    border: 1px dashed rgba(239, 68, 68, 0.45);
    background: rgba(127, 29, 29, 0.18);
  }
}

.listTool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  padding: 4px;
}

.listTool img,
.toolIcon {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: brightness(0) invert(0.8);
}

.toolIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.toolIcon svg {
  width: 100%;
  height: 100%;
  display: block;
}

.listColor {
  width: 20px;
  height: 20px;
  border: 2px solid var(--border-subtle);
  border-radius: 50%;
  flex-shrink: 0;
}

.listUser {
  flex: 1;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  &.muted {
    color: rgba(248, 113, 113, 0.9);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgba(248, 113, 113, 0.75);
  }
}

.listUser.self {
  color: rgba(255, 255, 255, 0.45);
  cursor: pointer;
}

.listUser.self:hover {
  text-decoration: underline;
}

.listActive {
  width: 8px;
  height: 8px;
  background: var(--accent-primary);
  border-radius: 50%;
  opacity: 0;
  transition: opacity var(--transition-normal);
}

.userEntry:hover .listActive {
  opacity: 0.5;
}

/* Rank-based username styling */
.listUser.rank-guest {
  color: var(--role-guest);
}

.listUser.rank-user {
  color: var(--role-user);
}

.listUser.rank-helper {
  color: var(--role-helper);
}

.listUser.rank-mod {
  color: var(--role-mod);
}

.listUser.rank-admin {
  color: var(--role-admin);
}

.listUser.rank-noble {
  color: var(--role-noble);
  text-shadow: 0 0 6px color-mix(in srgb, var(--role-noble), transparent 65%);
}

.listUser.rank-holy {
  color: var(--role-holy);
  text-shadow: 0 0 6px color-mix(in srgb, var(--role-holy), transparent 60%);
}

.listUser.rank-deity {
  color: var(--role-deity);
  text-shadow: 0 0 8px color-mix(in srgb, var(--role-deity), transparent 40%);
}

/* Noble/Holy/Deity border glow on user entry row */
.userEntry.rank-noble {
  border: 1px solid color-mix(in srgb, var(--role-noble), transparent 75%);
  box-shadow: 0 0 6px color-mix(in srgb, var(--role-noble), transparent 85%), inset 0 0 6px color-mix(in srgb, var(--role-noble), transparent 94%);
}

.userEntry.rank-holy {
  border: 1px solid color-mix(in srgb, var(--role-holy), transparent 70%);
  box-shadow: 0 0 8px color-mix(in srgb, var(--role-holy), transparent 80%), inset 0 0 6px color-mix(in srgb, var(--role-holy), transparent 94%);
}

.userEntry.rank-deity {
  border: 1px solid color-mix(in srgb, var(--role-deity), transparent 65%);
  box-shadow: 0 0 10px color-mix(in srgb, var(--role-deity), transparent 75%), inset 0 0 8px color-mix(in srgb, var(--role-deity), transparent 92%);
}

.listSync {
  visibility: hidden;
  transition: opacity var(--transition-fast);
}

.userEntry:hover .listSync {
  visibility: visible;
  opacity: 0.6;
}

.listSync:hover {
  opacity: 1.0 !important;
}

/* ========================================
   IP Group (same-IP users collapsed entry)
   ======================================== */

.userGroup {
  position: relative;
  border-radius: var(--radius-sm);
  border: 1.5px solid rgba(255, 255, 255, 0.18);
  margin-bottom: 8px;
  background: var(--bg-secondary);
  transition: transform 0.2s ease, margin-bottom 0.3s ease;
  overflow: visible;

  // Card stack layer 1 — offset down and right
  &::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 4px;
    left: 4px;
    right: -4px;
    bottom: -4px;
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  }

  // Card stack layer 2 — more offset
  &::after {
    content: '';
    position: absolute;
    z-index: -2;
    top: 8px;
    left: 8px;
    right: -8px;
    bottom: -8px;
    border: 1.5px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  }

  // When expanded, card stack is replaced by the actual user list
  &.expanded {
    margin-bottom: 12px;
    
    &::before {
      transform: translate(2px, 2px);
      opacity: 0.5;
    }
    
    &::after {
      transform: translate(4px, 4px);
      opacity: 0.2;
    }
  }

  // Group header styled like a normal userEntry
  .groupHeader {
    cursor: pointer;
    border-radius: var(--radius-sm);
    position: relative;
    z-index: 2;
    background: inherit;

    &:hover {
      background: var(--bg-elevated);
    }
  }
}

.groupCountBadge {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 9px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.07);
}

.groupUsers {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 0;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);

  .userEntry {
    background: transparent;
    padding: 6px 10px 6px 16px;
    border-radius: 0;
    font-size: 12px;
    opacity: 0.8;

    &:hover {
      background: rgba(255, 255, 255, 0.04);
      opacity: 1;
    }
  }
}

.userGroup.expanded .groupUsers {
  max-height: 1000px;
  opacity: 1;
  padding: 2px 0;
}

.group-only {
  display: none;
}
</file>

