      sw: Math.round(rect.width),
      sh: Math.round(rect.height)
    };

    if (lassoPath && lassoPath.length > 0) {
      msg.ps = lassoPath.flatMap(p => [p.x, p.y]);
    }
    this.send(msg);
  }

