                                <td>{c.score === -Infinity ? 'DQ' : c.score}</td>
                                <td>{c.active ? '✓' : '—'}</td>
                                <td>{c.lowPower ? '⚠️' : '—'}</td>
                              </tr>
                            {/each}
                          </tbody>
                        </table>
