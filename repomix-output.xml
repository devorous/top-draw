    const message = {
      t: T.CHAT_REACTION,
      chatMessageId: messageId,
      chatReaction: emoji,
      chatReactionRemove: remove
    };
    if (recipientId !== null && recipientId !== undefined) {
      message.r = recipientId;
    }
    this.send(message);
  }

